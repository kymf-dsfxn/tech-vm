#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8

  keyboard:
    layout: us

  source:
    id: ubuntu-server-minimal

  network:
    version: 2
    ethernets:
      ens192:
        addresses:
          - 10.66.82.102/24
        routes:
          - to: default
            via: 10.66.82.2
        nameservers:
          addresses:
            - 10.66.82.2

  storage:
    layout:
      name: direct
      match:
        size: smallest

  identity:
    hostname: xd00-lde-0020
    realname: recovery
    username: recovery
    password: "$6$ytzm4adGzWN/BtxW$.mknVc68BfA1A8tF8kxfVdAnVjK212fnyBSndomLjaaN/Aj.hl.gxSW7ZcyEZ4Cqsrxwegp.unzW8YC77jOlm0"

  ssh:
    install-server: true
    allow-pw: true

  late-commands:
    #  Recovery user: shift to UID/GID 404 
    - curtin in-target --target=/target -- usermod -u 404 recovery
    - curtin in-target --target=/target -- groupmod -g 404 recovery
    - find /target/home/recovery -user 1000 -exec chown 404:404 {} +
    - find /target/var/mail -user 1000 -exec chown 404:404 {} +

    #  Disable snapd 
    - curtin in-target --target=/target -- systemctl mask snapd.socket snapd.service

    #  Disable swap (strip any swap entries from fstab) 
    - sed -i '/[[:space:]]swap[[:space:]]/d' /target/etc/fstab

    #  Locale hardening (profile.d + skel) 
    - curtin in-target --target=/target -- apt-get install -y --no-install-recommends locales
    - printf 'export LANG=en_US.UTF-8\nexport LC_ALL=en_US.UTF-8\nexport TZ=UTC\n' > /target/etc/profile.d/locale.sh
    - chmod 0644 /target/etc/profile.d/locale.sh
    - printf '\nexport LANG=en_US.UTF-8\nexport LC_ALL=en_US.UTF-8\nexport TZ=UTC\n' >> /target/etc/skel/.bashrc
    - curtin in-target --target=/target -- locale-gen en_US.UTF-8
    - find /target/usr/share/i18n/locales -mindepth 1 -maxdepth 1 -type f ! -name 'en_US' ! -name 'C' ! -name 'POSIX' -exec rm -f {} +

    #  Add Platform admin user (qfree, UID/GID 500) 
    - curtin in-target --target=/target -- groupadd --gid 500 qfree
    - curtin in-target --target=/target -- useradd --comment qfree --create-home --system --shell /bin/bash --uid 500 --gid 500 --groups sudo qfree
    - printf 'qfree ALL=(ALL) NOPASSWD:ALL\n' > /target/etc/sudoers.d/010-qfree-nopw
    - chmod 0440 /target/etc/sudoers.d/010-qfree-nopw

    #  Add Node management user (qf_node_mgmt, UID/GID 501) 
    - curtin in-target --target=/target -- groupadd --gid 501 qf_node_mgmt
    - curtin in-target --target=/target -- useradd --comment qf_node_mgmt --create-home --system --shell /bin/bash --uid 501 --gid 501 --groups qfree,sudo qf_node_mgmt
    - printf 'qf_node_mgmt ALL=(ALL) NOPASSWD:ALL\n' > /target/etc/sudoers.d/010-qf_node_mgmt-nopw
    - chmod 0440 /target/etc/sudoers.d/010-qf_node_mgmt-nopw
    - curtin in-target --target=/target -- install --directory --mode=0700 --owner=qf_node_mgmt --group=qf_node_mgmt /home/qf_node_mgmt/.ssh
    - 'printf ''# PLACEHOLDER\n'' > /target/home/qf_node_mgmt/.ssh/authorized_keys'
    - chmod 0600 /target/home/qf_node_mgmt/.ssh/authorized_keys
    - curtin in-target --target=/target -- chown qf_node_mgmt:qf_node_mgmt /home/qf_node_mgmt/.ssh/authorized_keys

    #  Add Named user (kymf, auto UID/GID) 
    - curtin in-target --target=/target -- useradd --comment kymf --create-home --shell /bin/bash --groups qfree,sudo kymf
    - printf 'kymf ALL=(ALL) NOPASSWD:ALL\n' > /target/etc/sudoers.d/011-kymf-nopw
    - chmod 0440 /target/etc/sudoers.d/011-kymf-nopw
    - curtin in-target --target=/target -- install --directory --mode=0700 --owner=kymf --group=kymf /home/kymf/.ssh
    - 'printf ''ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFVMR/co7B2+NxHDZ/0pMyYnfj+x7w8JGRLR4Jqg+57K KymF: Disfixain Solutions Development (EdDSA-25519-20240510)\n'' > /target/home/kymf/.ssh/authorized_keys'
    - chmod 0600 /target/home/kymf/.ssh/authorized_keys
    - curtin in-target --target=/target -- chown kymf:kymf /home/kymf/.ssh/authorized_keys

    # Disable installation of recommended and suggested packages to minimize the base system.
    - curtin in-target --target=/target -- sh -c 'printf "APT::Install-Recommends \"0\";\nAPT::Install-Suggests \"0\";\n" > /etc/apt/apt.conf.d/99-no-recommends'
    - curtin in-target --target=/target -- apt-get update
    # Add package installs here and keep --no-install-recommends explicit.
    # Example:
    # - curtin in-target --target=/target -- apt-get install -y --no-install-recommends curl jq
    - curtin in-target --target=/target -- apt-get install -y --no-install-recommends open-vm-tools less tree nano dos2unix iputils-ping pv unzip pigz figlet locales

    #  MOTD banner 
    - rm -f /target/etc/update-motd.d/10-help-text
    - rm -f /target/etc/update-motd.d/60-unminimize
    - printf '#!/bin/bash\nfiglet -k "xd00-LDE" && figlet -k "0020"\n' > /target/etc/update-motd.d/99-banner
    - chmod 0755 /target/etc/update-motd.d/99-banner

    #  Build metadata: bake info file and image-build-info command into target
    - cp /cdrom/autoinstall/build-info.env /target/etc/image-build-info.env
    - chmod 0644 /target/etc/image-build-info.env
    - cp /cdrom/autoinstall/image-build-info /target/usr/local/bin/image-build-info
    - chmod 0755 /target/usr/local/bin/image-build-info
    #  Record the actual install moment (the ISO cannot know it)
    - sh -c 'printf "INSTALL_TIMESTAMP=%s\n" "$(date -u +%Y%m%dT%H%M%SZ)" >> /target/etc/image-build-info.env'
