#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8

  keyboard:
    layout: us

  source:
    id: ubuntu-server-minimal

  #  Install offline on every host, network or not. With a reachable mirror
  #  the installer applies security updates before the late-commands, and the
  #  target's libraries then outrun the release-only offline repo: an exact
  #  pin such as libssl-dev -> libssl3t64 can no longer be met. The dummy
  #  mirror is refused at once, so the installer falls back to an offline
  #  install without waiting on timeouts. guest-install.sh writes the real
  #  archive sources, and unattended-upgrades patches the node after first
  #  boot. Design: 01.iso-build/README.md, "The offline apt repository".
  apt:
    geoip: false
    fallback: offline-install
    mirror-selection:
      primary:
        - uri: "http://127.0.0.1/ubuntu"

  network:
    version: 2
    ethernets:
      ens192:
        addresses:
          - 10.66.83.103/24
        routes:
          - to: default
            via: 10.66.83.2
        nameservers:
          addresses:
            - 10.66.83.2

  #  The OS goes on the disk in VMware slot scsi0:0, where create-vm-instance.py
  #  puts the core disk. By slot, not size: the data disk (scsi0:1) can be any
  #  size. No disk in the slot stops the install; it never picks another disk.
  #  data-disk finds the data disk by the same rule (platform_node.py).
  storage:
    layout:
      name: direct
      match:
        id_path: "*-scsi-0:0:0:0"

  identity:
    hostname: xd00-lde-0030
    realname: recovery
    username: recovery
    password: "$6$ytzm4adGzWN/BtxW$.mknVc68BfA1A8tF8kxfVdAnVjK212fnyBSndomLjaaN/Aj.hl.gxSW7ZcyEZ4Cqsrxwegp.unzW8YC77jOlm0"

  ssh:
    install-server: true
    allow-pw: true

  late-commands:
    #  Copy the vm-init payload (scripts, on-ISO apt repo, artefacts, metadata)
    #  from the mounted ISO into the target.
    - mkdir -p /target/opt/vm-init
    - cp -a /cdrom/autoinstall/vm-init/. /target/opt/vm-init/
    #  cp -a keeps the build user's uid, which is 1000, the named user, in the
    #  target. The provisioning scripts must be root's.
    - chown -R root:root /target/opt/vm-init

    # guest-install.sh provisions the target; see its header.
    - curtin in-target --target=/target -- /opt/vm-init/guest-install.sh

