[Unit]
Description=Platform layer first-boot provisioning (data disk detection, SMB share)
Documentation=file:///opt/vm-init/guest-firstboot.sh
After=multi-user.target vmtoolsd.service
Wants=vmtoolsd.service
ConditionPathExists=!/var/lib/vm-init/firstboot.done

[Service]
Type=oneshot
ExecStart=/opt/vm-init/guest-firstboot.sh
RemainAfterExit=no
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
