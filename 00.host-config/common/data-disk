#!/usr/bin/env bash
# =============================================================================
# data-disk
#
# Operator command for the platform data disk lifecycle. The disk is LUKS
# encrypted and is NEVER unlocked at boot: there is no crypttab entry and the
# fstab entry is noauto, so a VM boots unattended with the data root simply
# absent. Unlocking is a deliberate act after an SSH login, and locking is its
# symmetric opposite.
#
#   data-disk init      One-time per disk: partition, luksFormat, mkfs.ext4.
#   data-disk unlock    cryptsetup open, mount, permissions, gated services up.
#   data-disk lock      Gated services down, umount, cryptsetup close.
#   data-disk status    What state the disk is in right now.
#
# The passphrase is only ever typed at this prompt. Nothing persists it: no
# keyfile, no crypttab, no host-side escrow. Lose it and the data is gone.
#
# The platform layer identity (namespace, users, data root) comes from
# /etc/platform.env, written by guest-install.sh at install time.
# =============================================================================

set -euo pipefail

PLATFORM_ENV="/etc/platform.env"
[[ -r "${PLATFORM_ENV}" ]] || {
    echo "FATAL: ${PLATFORM_ENV} missing or unreadable" >&2
    exit 1
}
# shellcheck source=/dev/null
. "${PLATFORM_ENV}"

DATA_DEV="/dev/sdb"
DATA_PART="${DATA_DEV}1"
DATA_LUKS_NAME="${PLATFORM_NAMESPACE}_data"
DATA_MAPPER="/dev/mapper/${DATA_LUKS_NAME}"
DATA_MOUNT="${PLATFORM_DATA_ROOT}"
DATA_OWNER="${PLATFORM_CORE_USER}"
DATA_GROUP="${PLATFORM_CORE_USER}"
DATA_MODE="2775"
# Mode for the bare mountpoint while the disk is locked. Deliberately closed:
# an unprivileged consumer must not be able to read or write the mountpoint
# when it is an ordinary empty directory on the root filesystem. Writes there
# would land on the OS disk, be shadowed the moment the real disk mounts, and
# read to a sync tool as "everything was deleted".
DATA_MOUNT_LOCKED_MODE="0500"

NAMED_USER="kymf"

# Services that consume the data root and must not run while it is locked.
# `unlock` starts these after the mount is up; `lock` stops them before it goes
# down. Each one also needs a systemd drop-in binding it to the mount, so that
# an out-of-band umount takes it down too:
#
#   /etc/systemd/system/<svc>.service.d/data-disk.conf
#     [Unit]
#     After=srv-<namespace>.mount
#     BindsTo=srv-<namespace>.mount
#
# smbd is deliberately NOT listed. It stays up whether or not the disk is
# unlocked, so the host still sees a live SMB server and gets a clear
# "share not available" rather than "host unreachable". The share stanza in
# /etc/samba/smb.conf gates itself instead, with a root preexec mount check.
#
# Resilio Sync belongs here once it is installed. It is not in the Ubuntu
# archive, so it needs a payload .deb under 00.host-config/common/payload/
# extra_deb/ before it can be added.
DATA_DISK_SERVICES=()

FORCE=0

log()  { echo "==> $*"; }
info() { echo "    $*"; }
warn() { echo "    WARNING: $*" >&2; }
die()  { echo "ERROR: $*" >&2; exit 1; }

usage() {
    cat <<EOF
data-disk - platform data disk lifecycle (namespace ${PLATFORM_NAMESPACE})

Usage: data-disk <command> [--force]

Commands:
  init      One-time per disk: partition ${DATA_DEV}, luksFormat, mkfs.ext4.
            Refuses a disk that already carries a LUKS header unless --force.
  unlock    cryptsetup open, mount ${DATA_MOUNT}, set permissions, start the
            services gated on the mount.
  lock      Stop the gated services, unmount, cryptsetup close. Refuses if the
            mount is busy; --force kills the holders first.
  status    Report the current state. The only command that does not need root.
            --brief prints a single line.

The disk is never unlocked at boot. Every unlock is a deliberate act, and the
passphrase is only ever typed at this prompt.
EOF
}

require_root() {
    [[ "${EUID}" -eq 0 ]] || die "$1 needs root. Try: sudo data-disk $1"
}

# --- State ------------------------------------------------------------------

dev_present()  { [[ -b "${DATA_DEV}" ]]; }
part_present() { [[ -b "${DATA_PART}" ]]; }
is_luks()      { part_present && cryptsetup isLuks "${DATA_PART}" 2> /dev/null; }
is_open()      { [[ -b "${DATA_MAPPER}" ]]; }
is_mounted()   { findmnt -rn --mountpoint "${DATA_MOUNT}" > /dev/null 2>&1; }

# One word for the whole disk. `opened` is the intermediate state where the
# LUKS mapper exists but the filesystem is not mounted.
disk_state() {
    if ! dev_present; then
        echo "absent"
    elif ! part_present || ! is_luks; then
        echo "uninitialised"
    elif is_mounted; then
        echo "unlocked"
    elif is_open; then
        echo "opened"
    else
        echo "locked"
    fi
}

luks_uuid() {
    if part_present && is_luks; then
        cryptsetup luksUUID "${DATA_PART}" 2> /dev/null || true
    fi
}

smb_user_configured() {
    command -v pdbedit > /dev/null 2>&1 \
        && pdbedit -L 2> /dev/null | grep -q "^${NAMED_USER}:"
}

# --- Shared actions ---------------------------------------------------------

# Enforce writable group access on the mounted filesystem root. Mirrors the
# helper of the same name in guest-firstboot.sh.
ensure_data_mount_permissions() {
    chown "${DATA_OWNER}:${DATA_GROUP}" "${DATA_MOUNT}"
    chmod "${DATA_MODE}" "${DATA_MOUNT}"
    info "${DATA_MOUNT} perms $(stat -c '%U:%G %a' "${DATA_MOUNT}")"
}

# Close down the bare mountpoint once the real filesystem is gone. Only safe
# when nothing is mounted there, otherwise this would chmod the ext4 root.
secure_bare_mountpoint() {
    if is_mounted; then
        warn "${DATA_MOUNT} still mounted, leaving its permissions alone"
        return 0
    fi
    install -d -o root -g root -m "${DATA_MOUNT_LOCKED_MODE}" "${DATA_MOUNT}"
    local stray
    stray="$(find "${DATA_MOUNT}" -mindepth 1 -maxdepth 1 2> /dev/null | wc -l)"
    if [[ "${stray}" -gt 0 ]]; then
        warn "${stray} entr(y|ies) written into the bare mountpoint ${DATA_MOUNT}"
        warn "these live on the OS disk and are hidden when the data disk mounts"
    fi
}

start_gated_services() {
    [[ "${#DATA_DISK_SERVICES[@]}" -gt 0 ]] || return 0
    local service
    for service in "${DATA_DISK_SERVICES[@]}"; do
        log "Start ${service}"
        systemctl start "${service}" || warn "${service} failed to start"
    done
}

stop_gated_services() {
    [[ "${#DATA_DISK_SERVICES[@]}" -gt 0 ]] || return 0
    local index service
    # Reverse order, so a dependent stops before what it depends on.
    for (( index = ${#DATA_DISK_SERVICES[@]} - 1; index >= 0; index-- )); do
        service="${DATA_DISK_SERVICES[index]}"
        log "Stop ${service}"
        systemctl stop "${service}" || warn "${service} failed to stop"
    done
}

# --- init -------------------------------------------------------------------

cmd_init() {
    require_root init
    dev_present || die "${DATA_DEV} is not present. Nothing to initialise."
    if is_mounted; then
        die "${DATA_MOUNT} is mounted. Run 'data-disk lock' first."
    fi
    if is_open; then
        die "${DATA_LUKS_NAME} is open. Run 'data-disk lock' first."
    fi

    if part_present && is_luks && [[ "${FORCE}" -ne 1 ]]; then
        die "${DATA_PART} already carries a LUKS header. Initialising would
       destroy it. Run 'data-disk unlock' to use the existing disk, or
       'data-disk init --force' to deliberately reformat it."
    fi

    if ! part_present; then
        log "Partition ${DATA_DEV} (GPT, single partition)"
        printf 'label: gpt\n, , L\n' | sfdisk "${DATA_DEV}"
        udevadm settle || true
        part_present || die "${DATA_PART} did not appear after partitioning"
    else
        info "${DATA_PART} already exists, reusing the partition"
    fi

    log "luksFormat ${DATA_PART}"
    info "You are about to set a NEW passphrase. Nothing stores it for you."
    cryptsetup luksFormat --type luks2 "${DATA_PART}"

    log "Open ${DATA_PART} as ${DATA_LUKS_NAME}"
    cryptsetup open "${DATA_PART}" "${DATA_LUKS_NAME}"

    log "Create the filesystem on ${DATA_MAPPER}"
    mkfs.ext4 -F -L "${DATA_LUKS_NAME}" "${DATA_MAPPER}"

    log "Initialised (LUKS UUID $(luks_uuid))"
    info "The mapper is open but nothing is mounted yet."
    info "Next: sudo data-disk unlock"
    if ! smb_user_configured; then
        info "SMB access also needs a password: sudo smbpasswd -a ${NAMED_USER}"
    fi
}

# --- unlock -----------------------------------------------------------------

cmd_unlock() {
    require_root unlock
    dev_present || die "${DATA_DEV} is not present. Is the data disk attached?"
    if ! part_present || ! is_luks; then
        die "${DATA_PART} carries no LUKS header. Run 'data-disk init' first."
    fi

    if is_open; then
        info "${DATA_LUKS_NAME} already open"
    else
        log "Open ${DATA_PART} as ${DATA_LUKS_NAME}"
        cryptsetup open "${DATA_PART}" "${DATA_LUKS_NAME}"
    fi

    if is_mounted; then
        info "${DATA_MOUNT} already mounted"
    else
        log "Mount ${DATA_MOUNT}"
        install -d "${DATA_MOUNT}"
        if grep -qE "^[^#].*[[:space:]]${DATA_MOUNT}[[:space:]]" /etc/fstab; then
            mount "${DATA_MOUNT}"
        else
            warn "no fstab entry for ${DATA_MOUNT}, mounting explicitly"
            mount "${DATA_MAPPER}" "${DATA_MOUNT}"
        fi
    fi

    ensure_data_mount_permissions
    start_gated_services

    log "Unlocked"
    cmd_status
}

# --- lock -------------------------------------------------------------------

cmd_lock() {
    require_root lock

    stop_gated_services

    if is_mounted; then
        log "Unmount ${DATA_MOUNT}"
        if ! umount "${DATA_MOUNT}" 2> /dev/null; then
            if [[ "${FORCE}" -ne 1 ]]; then
                warn "${DATA_MOUNT} is busy. Holders:"
                if command -v fuser > /dev/null 2>&1; then
                    fuser -vm "${DATA_MOUNT}" 2>&1 | sed 's/^/    /' || true
                else
                    warn "fuser not available (install psmisc) - try: lsof +D ${DATA_MOUNT}"
                fi
                die "Nothing was unmounted. Close the holders, or run
       'data-disk lock --force' to kill them and unmount anyway."
            fi
            warn "--force: killing processes holding ${DATA_MOUNT}"
            if command -v fuser > /dev/null 2>&1; then
                fuser -km "${DATA_MOUNT}" || true
            fi
            umount "${DATA_MOUNT}" 2> /dev/null || umount -l "${DATA_MOUNT}"
        fi
    else
        info "${DATA_MOUNT} not mounted"
    fi

    if is_open; then
        log "Close ${DATA_LUKS_NAME}"
        cryptsetup close "${DATA_LUKS_NAME}"
    else
        info "${DATA_LUKS_NAME} not open"
    fi

    secure_bare_mountpoint

    log "Locked"
    cmd_status
}

# --- status -----------------------------------------------------------------

cmd_status() {
    local state
    state="$(disk_state)"

    if [[ "${BRIEF:-0}" -eq 1 ]]; then
        case "${state}" in
            unlocked) echo "data disk: unlocked at ${DATA_MOUNT}" ;;
            opened)   echo "data disk: open but not mounted - sudo data-disk unlock" ;;
            locked)   echo "data disk: locked - sudo data-disk unlock" ;;
            uninitialised) echo "data disk: not initialised - sudo data-disk init" ;;
            absent)   echo "data disk: ${DATA_DEV} not attached" ;;
        esac
        return 0
    fi

    printf '  %-12s %s\n' "namespace" "${PLATFORM_NAMESPACE}"
    printf '  %-12s %s\n' "state" "${state}"
    printf '  %-12s %s\n' "device" \
        "${DATA_DEV} $(dev_present && echo '(present)' || echo '(absent)')"
    printf '  %-12s %s\n' "partition" \
        "${DATA_PART} $(part_present && echo '(present)' || echo '(absent)')"
    printf '  %-12s %s\n' "luks" \
        "$(is_luks && echo "header present, UUID $(luks_uuid)" || echo 'no header')"
    printf '  %-12s %s\n' "mapper" \
        "${DATA_MAPPER} $(is_open && echo '(open)' || echo '(closed)')"

    if is_mounted; then
        printf '  %-12s %s\n' "mount" "${DATA_MOUNT} (mounted)"
        printf '  %-12s %s\n' "perms" "$(stat -c '%U:%G %a' "${DATA_MOUNT}")"
        printf '  %-12s %s\n' "usage" \
            "$(df -h --output=used,size,pcent "${DATA_MOUNT}" | tail -1 | tr -s ' ')"
    else
        printf '  %-12s %s\n' "mount" "${DATA_MOUNT} (not mounted)"
    fi

    printf '  %-12s %s\n' "smb user" \
        "$(smb_user_configured && echo "${NAMED_USER} configured" \
            || echo "${NAMED_USER} has no SMB password - sudo smbpasswd -a ${NAMED_USER}")"
    if command -v systemctl > /dev/null 2>&1; then
        printf '  %-12s %s\n' "smbd" "$(systemctl is-active smbd 2> /dev/null || true)"
    fi

    local service
    for service in "${DATA_DISK_SERVICES[@]+"${DATA_DISK_SERVICES[@]}"}"; do
        printf '  %-12s %s\n' "${service}" \
            "$(systemctl is-active "${service}" 2> /dev/null || true)"
    done
}

# --- Dispatch ---------------------------------------------------------------

COMMAND="${1:-}"
shift || true

BRIEF=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --force) FORCE=1 ;;
        --brief) BRIEF=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unknown option: $1" ;;
    esac
    shift
done

case "${COMMAND}" in
    init)   cmd_init ;;
    unlock) cmd_unlock ;;
    lock)   cmd_lock ;;
    status) cmd_status ;;
    ""|-h|--help|help) usage ;;
    *) usage >&2; die "Unknown command: ${COMMAND}" ;;
esac
