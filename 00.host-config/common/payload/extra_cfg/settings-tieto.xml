<?xml version="1.0" encoding="UTF-8"?>
<!-- Tieto Banktech context. Selected by MAVEN_ARGS from gh-tb/.envrc.
     maven-common is an Artifactory virtual repository: Tieto-internal artifacts
     plus a proxy of Maven Central. Anonymous read works, so resolution needs no
     credentials. Design: tech-vm capability.multi-company-build.md -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 http://maven.apache.org/xsd/settings-1.2.0.xsd">
  <localRepository>${user.home}/.m2/repo-tieto</localRepository>

  <mirrors>
    <mirror>
      <id>maven-common</id>
      <mirrorOf>*</mirrorOf>
      <url>https://artifactory.finods.com/artifactory/maven-common</url>
    </mirror>
  </mirrors>

  <!-- Needed only to deploy. Ids must match parent-pom distributionManagement.
       Use your own account and an Artifactory access token from the environment.
  <servers>
    <server>
      <id>artifactory-release</id>
      <username>REPLACE</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
    <server>
      <id>artifactory-snapshot</id>
      <username>REPLACE</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
  </servers>
  -->
</settings>
