# /etc/gitconfig
#
# System-wide git settings for the platform guest. Installed by
# guest-install.sh.

# The share holds the working repositories and nothing in it is owned by the
# person editing it: everything arriving over Syncthing lands owned by stsync,
# because ownership never replicates (capability.data-synchronisation.md,
# "Permission replication"). Git's dubious-ownership check then refuses every
# repository under the share for the named user - the working tree is writable
# through group dsfxn, but git will not look at it.
#
# The trailing /* form covers repositories at any depth below the share
# without the blanket '*', which would exempt every repository on the node
# including any unpacked from an untrusted archive.
#
# This is an exemption from a check, not a grant: it says the share's contents
# are as trustworthy as the accounts on the encrypted disk, which they are.
[safe]
	directory = /srv/dsfxn/share/*

# Author identity follows the company tree, on every host and with no shell
# hook. Each include file is in the named user's home overlay
# (~/.config/git/identity-*.inc). The trailing / matches every repository below
# the tree. useConfigOnly stops git inventing an identity from the host name, so
# a commit outside the three trees fails until the repository sets its own.
# Design: tech-vm capability.multi-company-build.md.
[user]
	useConfigOnly = true
[includeIf "gitdir:/srv/dsfxn/share/10.dev/10.repos/gh-qf/"]
	path = ~/.config/git/identity-qf.inc
[includeIf "gitdir:/srv/dsfxn/share/10.dev/10.repos/gh-tb/"]
	path = ~/.config/git/identity-tb.inc
[includeIf "gitdir:/srv/dsfxn/share/10.dev/10.repos/gh-dsfxn/"]
	path = ~/.config/git/identity-dsfxn.inc
