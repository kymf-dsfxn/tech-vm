<configuration version="52">
    <!-- =====================================================================
         Guest node template for the platform share. Design:
         capability.data-synchronisation.md.

         This template ships COMPLETE: every estate value is a literal here,
         so a guest renders with no hand editing at all. Only the AUTOFILL_
         namespace remains, and render fills it on the node:
           AUTOFILL_DEVICE_ID_SELF       from the identity on the encrypted disk
           AUTOFILL_DEVICE_NAME          this guest's host name
           AUTOFILL_API_KEY              128 fresh random bits, per node

         The estate values below (folder id, hub device id, hub address) are
         identical on every guest and none is a secret - a device id is a
         public key. They are edited HERE, in the REPOSITORY copy at
         00.host-config/common/payload/extra_cfg/syncthing/, when the estate
         itself changes; a guest-only edit to /etc/syncthing/ works for that
         guest and is lost at the next image.

         The MANUALLY_FIX_ mechanism is retained, not retired: render still
         refuses to write while any such token survives, which is what guards
         a value added later (the relay line below is the standing example).
         An empty MANUALLY_FIX_ set is the normal state, not a disabled check.

         The hub port is a fixed 22000: the router forwards 22000 to 22000 by
         intention. See the hub address comment below.

         version="52" is what Syncthing 2.1.3 writes; author at the version the
         binary writes or the on-ISO file and the in-service file disagree from
         the first start. Syncthing owns this file once it has run: a starting
         point, not something to re-apply. An XML comment may not contain two
         consecutive hyphens, which is why option names avoid them here.
         ===================================================================== -->

    <!-- The folder id must equal the hub's, character for character: folders
         match across devices by ID alone. It cannot be changed after the
         folder is created, and the hub's id is already held by the laptops, so
         the guest is always the side that changes. Re-read it on the hub (Edit
         Folder, or `syncthing cli config folders list`) before ever editing
         this line. A mismatch does not error - it arrives as a New Folder
         offer with a nested-path warning. The label is local and may say
         anything. -->
    <folder id="wqa6q-yhpjx" label="data-sync" path="/srv/dsfxn/share"
            type="sendreceive" rescanIntervalS="3600" fsWatcherEnabled="true"
            fsWatcherDelayS="10" ignorePerms="false" autoNormalize="true">
        <filesystemType>basic</filesystemType>
        <device id="AUTOFILL_DEVICE_ID_SELF" introducedBy=""></device>
        <device id="IHWXMZT-6XMZUH6-YCR37GD-PFHI4NP-6ZNFLP4-2ZRYH2C-4IUONRQ-54FLLAC" introducedBy=""></device>

        <!-- markerName is a CHILD element, not an attribute: as an attribute
             it is accepted, silently ignored, and the guard reverts to
             .stfolder. Read the effective value back with `sync-node marker`.
             The non-default name is deliberate - Syncthing auto-creates only
             .stfolder, so this one is never recreated behind your back and the
             folder is refused whenever the marker is absent (the folder marker
             invariant). -->
        <markerName>.dsfxn-share-marker</markerName>

        <minDiskFree unit="%">5</minDiskFree>

        <!-- Versioning is the recovery net for the empty-folder mistake. Keep it. -->
        <versioning type="staggered">
            <param key="maxAge" val="2592000"></param>
            <cleanupIntervalS>3600</cleanupIntervalS>
            <fsPath></fsPath>
            <fsType>basic</fsType>
        </versioning>

        <maxConflicts>10</maxConflicts>
        <order>random</order>
        <maxConcurrentWrites>16</maxConcurrentWrites>
        <blockIndexing>true</blockIndexing>

        <!-- Ownership never replicates (would need syncOwnership plus extra
             capabilities, deliberately off). Each device owns its own copy. -->
        <syncOwnership>false</syncOwnership>
        <sendOwnership>false</sendOwnership>
        <syncXattrs>false</syncXattrs>
        <sendXattrs>false</sendXattrs>

        <!-- ignorePerms false (above): permission bits replicate, which works
             only because every Linux node writes with umask 0002 (UMask=0002
             in the unit drop-in). Windows nodes keep Ignore Permissions set,
             and a file edited there loses its executable bit everywhere,
             permanently - keep executables in git. Full model:
             capability.data-synchronisation.md, "Permission replication". -->
    </folder>

    <device id="AUTOFILL_DEVICE_ID_SELF" name="AUTOFILL_DEVICE_NAME"
            compression="metadata" introducer="false" skipIntroductionRemovals="false"
            introducedBy="">
        <address>dynamic</address>
        <paused>false</paused>
        <autoAcceptFolders>false</autoAcceptFolders>
        <untrusted>false</untrusted>
    </device>

    <!-- The hub is the only device a guest needs to know; it introduces the
         others. introducer="true" sits on the guest's entry FOR the hub ("I
         trust this device to tell me about others"); the hub marks nobody, and
         two devices are never mutual introducers. autoAcceptFolders stays
         false so a local path is always a decision.

         One name, two transports, dialled in no particular order (priority
         comes from the connectionPriority values below). There is deliberately
         no "dynamic" entry: discovery cannot reach the NAS from behind VMware
         NAT so it would resolve to nothing on every dial - add it back the day
         a guest moves to bridged networking. Rationale:
         capability.data-synchronisation.md, "Connectivity". -->
    <device id="IHWXMZT-6XMZUH6-YCR37GD-PFHI4NP-6ZNFLP4-2ZRYH2C-4IUONRQ-54FLLAC" name="ds-nas-01"
            compression="metadata" introducer="true" skipIntroductionRemovals="false"
            introducedBy="">
        <!-- One address for both paths, on a fixed 22000: the router forwards
             22000 to the hub's 22000, deliberately untranslated. Translating
             the external port to a non-default one is a documented hardening
             option, not taken (capability.data-synchronisation.md,
             "Exposure"); taking it means changing the port here on every node.

             There is no separate LAN address, and that rests on one assumption:
             the house resolver answers sync.disfix.net with the hub's LAN
             address (10.66.10.117) rather than the WAN one, so a guest at home
             dials straight to the NAS. Without that split horizon the name
             resolves to the WAN address and the dial hairpins into the router,
             which needs NAT reflection - off on OPNsense - and fails. The
             assumption is therefore load bearing: it lives on OPNsense as an
             Unbound host override, not in this file. If home connections start
             failing while remote ones work, check that override first. Test
             remote access from a mobile hotspot; the home LAN never exercises
             the forward. -->
        <address>tcp://sync.disfix.net:22000</address>
        <address>quic://sync.disfix.net:22000</address>
        <paused>false</paused>
        <autoAcceptFolders>false</autoAcceptFolders>
        <untrusted>false</untrusted>
    </device>

    <gui enabled="true" tls="false" debugging="false" sendBasicAuthPrompt="false">
        <!-- Loopback only, never on the network. Reach it with: sync-node gui -->
        <address>127.0.0.1:8384</address>
        <apikey>AUTOFILL_API_KEY</apikey>
        <theme>default</theme>
        <metricsWithoutAuth>false</metricsWithoutAuth>
    </gui>

    <ldap></ldap>

    <options>
        <!-- Listen addresses are explicit. The value "default" pulls in the
             public relay pool, which is the vendor dependency this design
             removes. -->
        <listenAddress>tcp://0.0.0.0:22000</listenAddress>
        <listenAddress>quic://0.0.0.0:22000</listenAddress>

        <!-- No relay is built (capability.data-synchronisation.md, "The relay
             decision"). A relay address that resolves to nothing is not
             harmless: the listener supervisor retries forever, one WRN line
             per attempt. If a relay is ever built, add the line below with the
             real values and set relaysEnabled to true:

             <listenAddress>relay://MANUALLY_FIX_RELAY_ADDRESS:22067/?id=MANUALLY_FIX_RELAY_DEVICE_ID&amp;token=MANUALLY_FIX_RELAY_TOKEN</listenAddress>
        -->
        <relaysEnabled>false</relaysEnabled>

        <!-- No announcement ever reaches a Syncthing server. Local discovery
             stays on for the vmnet (other VMs, the host laptop's Syncthing);
             it never reaches the NAS. -->
        <globalAnnounceEnabled>false</globalAnnounceEnabled>
        <localAnnounceEnabled>true</localAnnounceEnabled>
        <localAnnouncePort>21027</localAnnouncePort>

        <!-- The whole estate counts as local. This carries more weight now
             that one name serves both paths: at home the name resolves to
             10.66.10.117, and it is this setting - not the address list - that
             makes the resulting connection count as LAN. Without it a guest
             (always on a different subnet from the NAS) classes that same
             connection as WAN and gives it priority 30 instead of 10. Also
             exempts these connections from any later rate limit. -->
        <alwaysLocalNet>10.66.0.0/16</alwaysLocalNet>

        <!-- The guest dials out. Nothing dials in, so there is nothing to map. -->
        <natEnabled>false</natEnabled>

        <urAccepted>-1</urAccepted>
        <crashReportingEnabled>false</crashReportingEnabled>

        <!-- The image installs offline and upgrades belong to the image. The
             packaged binary is a [noupgrade] build in any case. -->
        <autoUpgradeIntervalH>0</autoUpgradeIntervalH>

        <reconnectionIntervalS>60</reconnectionIntervalS>
        <keepTemporariesH>24</keepTemporariesH>
        <progressUpdateIntervalS>5</progressUpdateIntervalS>
        <minHomeDiskFree unit="%">1</minHomeDiskFree>
        <startBrowser>false</startBrowser>
        <setLowPriority>true</setLowPriority>
        <announceLANAddresses>true</announceLANAddresses>

        <!-- Deliberately no unackedNotificationID element: listing an ID makes
             the GUI SHOW that notification (an earlier draft listed one and
             produced the auth nag on every fresh node). The red "Danger" panel
             is a different mechanism, raised only off loopback. -->

        <connectionPriorityTcpLan>10</connectionPriorityTcpLan>
        <connectionPriorityQuicLan>20</connectionPriorityQuicLan>
        <connectionPriorityTcpWan>30</connectionPriorityTcpWan>
        <connectionPriorityQuicWan>40</connectionPriorityQuicWan>
        <connectionPriorityRelay>50</connectionPriorityRelay>
    </options>

    <!-- The defaults carry the marker name too, so a folder added later
         inherits the guard instead of falling back to .stfolder. The defaults
         path is the share on purpose: an offered folder then draws a nested
         path warning, and a second folder on this guest is a mistake (usually
         a folder ID not matching the hub). -->
    <defaults>
        <folder path="/srv/dsfxn/share" type="sendreceive" rescanIntervalS="3600"
                fsWatcherEnabled="true" fsWatcherDelayS="10" ignorePerms="false"
                autoNormalize="true">
            <filesystemType>basic</filesystemType>
            <markerName>.dsfxn-share-marker</markerName>
            <minDiskFree unit="%">5</minDiskFree>
            <versioning type="staggered">
                <param key="maxAge" val="2592000"></param>
                <cleanupIntervalS>3600</cleanupIntervalS>
            </versioning>
            <maxConflicts>10</maxConflicts>
        </folder>
        <device compression="metadata" introducer="false" skipIntroductionRemovals="false"
                introducedBy="">
            <address>dynamic</address>
            <autoAcceptFolders>false</autoAcceptFolders>
        </device>
        <ignores></ignores>
    </defaults>
</configuration>
