# Tunnels
# Combined SOCKS + fixed tunnels
# Windows Version not using Quality of life bits
# ssh cosng-tunnel
Host cosng-tunnel
    HostName ssh.cosng.net
    User e799118

    # SOCKS proxy
    DynamicForward 127.0.0.1:12345

    # Static tunnels (ASE, IQ, PG)
    LocalForward 127.0.0.1:44103 dat-aca-r-syb02.unix.cosng.net:4103
    LocalForward 127.0.0.1:44110 dat-dbi-r-syb01.unix.cosng.net:4110
    LocalForward 127.0.0.1:46500 pg-dbn-r-c02.unix.cosng.net:6500

    # Reliability
    ExitOnForwardFailure yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Prevent interactive session
    RequestTTY no
    SessionType none

