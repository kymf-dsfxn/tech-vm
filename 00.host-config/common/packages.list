# packages.list - single source of truth for guest apt packages, one per line.
# build-package-repo.sh resolves the dependency closure into the on-ISO repo.
# Packages shipped as payload .debs must NOT be listed (a listed name would
# resolve a second, different copy from the archive); their dependencies must be.

# Base utilities & VMware guest agent
open-vm-tools
less
tree
nano
dos2unix
iputils-ping
pv
unzip
pigz
figlet
locales

# Developer toolchain
git
openjdk-25-jdk-headless
python3
python3-build
python3-venv
apt-rdepends
podman
uidmap
passt
xorriso
build-essential
#   pkg-config - how most C build systems locate libpq (libpq-dev ships
#                libpq.pc); build-essential does not pull it in.
pkg-config

# Local-build toolchain: matches what the sdlc build images install, so the VM
# can run full local builds of the code they cover. Non-apt tools (syft, shfmt,
# uv) are pinned binaries staged by fetch-build-tools.sh, not listed here.
python3-pip
shellcheck

# Data disk encryption + SMB file sharing
#   cryptsetup-bin - the cryptsetup CLI only.
#   samba          - serves the platform data root to the Windows host.
#   psmisc         - fuser, used by `data-disk lock`.
cryptsetup-bin
samba
psmisc

# Syncthing replication of shared data
#   procps       - the only dependency of syncthing_*_amd64.deb beyond libc6.
#                  Syncthing itself comes from .deb under payload/extra_deb/.
procps

# Postgres DB Client & Development
#   libpq-dev puts libpq-fe.h under /usr/include/postgresql, so C builds need
#   `pkg-config --cflags libpq` or -I$(pg_config --includedir); a bare -lpq
#   does not find the header.
postgresql-client-18
libpq-dev

# SAP ASE / SQL Anywhere clients (unpacked from payload/extra_tgz, see
# guest-install.sh). The bundles are self-contained apart from one library:
#   libncurses6  - dbisqlc, the SQL Anywhere character-mode client, is still
#                  linked against the ncurses 5 soname. Ubuntu ships no
#                  ncurses 5, and only libncursesw6 arrives as a dependency of
#                  other packages, so the non-wide runtime is named here for
#                  the compat link guest-install.sh creates onto it.
libncurses6
